DISCORD_TOKEN=<YOUR_BOT_TOKEN>
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.1-flash-lite
COOLDOWN_SECONDS=45

# Daily roast + Question of the Day poll (optional)
# Right-click channel → Copy Channel ID (enable Developer Mode in Discord settings)
DAILY_CHANNEL_ID=
DAILY_CRON=0 12 * * *
DAILY_TZ=America/New_York
DAILY_MESSAGES_PER_CHANNEL=12
DAILY_MAX_MESSAGES=60
# Optional comma-separated channel IDs to skip
DAILY_EXCLUDE_CHANNELS=
