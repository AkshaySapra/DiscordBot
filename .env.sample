DISCORD_TOKEN=<YOUR_BOT_TOKEN>
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.1-flash-lite
COOLDOWN_SECONDS=45

# Your Discord user ID (Spicy) — right-click yourself → Copy User ID
# Comma-separate if multiple owners
OWNER_USER_ID=

# Daily in-channel roasts + optional QOTD poll
# Use quotes when the value has spaces:
DAILY_CRON="0 12 * * *"
DAILY_TZ=America/New_York
DAILY_ROAST_LIMIT=5
DAILY_MESSAGES_PER_CHANNEL=15
DAILY_MAX_MESSAGES=80
RUNDAILY_COOLDOWN_SECONDS=1800

# Optional: where to post the Question of the Day poll
DAILY_CHANNEL_ID=
# Optional: pin which server to scan on the schedule
GUILD_ID=
# Optional comma-separated channel IDs to skip
DAILY_EXCLUDE_CHANNELS=
